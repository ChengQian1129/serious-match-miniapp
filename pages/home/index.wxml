<view class="page home-page" style="padding-top: {{statusBarHeight}}px;">
  <view class="home-hero">
    <view class="home-wordmark"><view class="home-mark"><view class="home-mark__bar home-mark__bar--first"></view><view class="home-mark__bar home-mark__bar--last"></view></view></view>
    <view class="home-copy">
      <view class="home-title">{{heroTitle}}</view>
      <view class="home-desc">{{heroDesc}}</view>
      <view wx:if="{{progressText}}" class="home-note">{{progressText}}</view>
      <view wx:if="{{isProductMode && productHasData && productRestoreState === 'READY'}}" class="home-progress-block">
        <view class="home-progress-block__section">{{productSectionTitle}}</view>
        <view class="home-progress-block__detail">{{productSectionProgress}} · {{productCompletedSections}}</view>
        <view wx:if="{{productSaveLabel}}" class="home-progress-block__save">{{productSaveLabel}}</view>
      </view>
    </view>
    <view class="home-actions dl-stack">
      <button class="dl-button" disabled="{{isProductMode && !productCanStart}}" bind:tap="handleStart">{{actionText}}</button>
      <button class="dl-button dl-button--outline" bind:tap="openGuide">{{guideAction}}</button>
    </view>
  </view>
  <view wx:if="{{isProductMode && productRestoreState === 'RESTORE_ERROR'}}" class="home-restore-panel home-restore-panel--error" role="alert">
    <view class="home-restore-panel__title">{{productCopy.home.restoreErrorTitle}}</view>
    <view class="home-restore-panel__body">{{productRestoreError}}</view>
    <view class="home-restore-panel__actions">
      <button class="home-restore-panel__action" bind:tap="retryProductSync">{{productCopy.home.retryAction}}</button>
      <button wx:if="{{productCanUseLocal}}" class="home-restore-panel__action" bind:tap="useLocalProgress">{{productCopy.home.useLocalAction}}</button>
      <button wx:if="{{!productHasData}}" class="home-restore-panel__action" bind:tap="startOffline">{{productCopy.home.offlineAction}}</button>
    </view>
  </view>
  <view wx:if="{{isProductMode && productRestoreState === 'RESTORE_CONFLICT'}}" class="home-restore-panel home-restore-panel--conflict" role="alert">
    <view class="home-restore-panel__title">{{productCopy.home.conflictTitle}}</view>
    <view class="home-restore-panel__body">{{productRestoreError}}</view>
    <view class="home-restore-panel__actions">
      <button wx:if="{{productCanUseCloud}}" class="home-restore-panel__action" bind:tap="useCloudProgress">{{productCopy.home.useCloudAction}}</button>
      <button wx:if="{{productCanUseLocal}}" class="home-restore-panel__action" bind:tap="useLocalProgress">{{productCopy.home.useLocalAction}}</button>
    </view>
  </view>
  <view class="home-example">
    <view class="section-title">{{exampleLabel}}</view>
    <view class="home-example__text">{{exampleText}}</view>
  </view>
  <view class="home-process">
    <view class="section-title home-section-title">{{topicsTitle}}</view>
    <view class="home-topics"><view wx:for="{{topics}}" wx:key="*this" class="home-topic">{{item}}</view></view>
  </view>
  <view class="home-pool-note">{{followupHint}}</view>
  <view wx:if="{{isProductMode && productRestoreState === 'RESTORING'}}" class="home-restore-status" role="status">{{productCopy.home.restoringDescription}}</view>
  <view class="home-utility-links">
    <button class="home-utility-link" bind:tap="openPrivacy">{{privacyAction}}</button>
    <button wx:if="{{productHasData}}" class="home-utility-link home-utility-link--danger" loading="{{productDeleting}}" bind:tap="deleteProductData">{{productDeleteAction}}</button>
  </view>
</view>

<t-popup placement="bottom" visible="{{showGuide}}" bind:visible-change="handleGuideVisibleChange">
  <view class="sheet-content">
    <view class="sheet-title">{{guideTitle}}</view>
    <view class="sheet-copy">{{guideBody}}</view>
    <view class="sheet-copy">{{guideFocus}}</view>
    <view class="sheet-action"><button class="dl-button" bind:tap="closeGuide">{{guideCloseAction}}</button></view>
  </view>
</t-popup>
