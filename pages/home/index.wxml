<view class="page home-page" style="padding-top: {{statusBarHeight}}px;">
  <view class="home-hero">
    <view class="home-wordmark"><view class="home-mark"><view></view><view></view></view><text>关系说明书</text></view>
    <view class="home-copy">
      <view class="page-kicker">关系说明书</view>
      <view class="home-title">{{heroTitle}}</view>
      <view class="home-desc">{{heroDesc}}</view>
      <view wx:if="{{progressText}}" class="home-note">{{progressText}}</view>
    </view>
    <view class="home-actions dl-stack">
      <button class="dl-button" bind:tap="handleStart">{{actionText}}</button>
      <button class="dl-button dl-button--outline" bind:tap="openGuide">{{guideAction}}</button>
    </view>
  </view>
  <view class="home-example">
    <view class="section-title">{{exampleLabel}}</view>
    <view class="home-example__text">{{exampleText}}</view>
  </view>
  <view class="home-process">
    <view class="section-title home-section-title">{{topicsTitle}}</view>
    <view class="home-topics"><view wx:for="{{topics}}" wx:key="*this" class="home-topic">{{item}}</view></view>
  </view>
  <view class="home-pool-note">{{followupHint}}</view>
</view>

<t-popup placement="bottom" visible="{{showGuide}}" bind:visible-change="handleGuideVisibleChange">
  <view class="sheet-content">
    <view class="sheet-title">{{guideTitle}}</view>
    <view class="sheet-copy">{{guideBody}}</view>
    <view class="sheet-copy">{{guideFocus}}</view>
    <view class="sheet-action"><button class="dl-button" bind:tap="closeGuide">{{guide.closeAction}}</button></view>
  </view>
</t-popup>

<t-popup placement="bottom" visible="{{showStorageChoice}}" bind:visible-change="handleStorageVisibleChange">
  <view class="sheet-content">
    <view class="sheet-title">{{storageTitle}}</view>
    <view class="sheet-copy">{{storageBody}}</view>
    <view class="sheet-action dl-stack">
      <button class="dl-button" bind:tap="chooseCloudStorage">{{storageCloudLabel}}</button>
      <button class="dl-button dl-button--outline" bind:tap="chooseLocalStorage">{{storageLocalLabel}}</button>
    </view>
  </view>
</t-popup>
