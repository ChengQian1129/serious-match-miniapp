.home-hero {
  display: flex;
  min-height: 760rpx;
  flex-direction: column;
  padding: 42rpx var(--dl-gutter) 52rpx;
}

.home-wordmark {
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: 27rpx;
  font-weight: 700;
  white-space: nowrap;
}

.home-mark {
  position: relative;
  width: 42rpx;
  height: 36rpx;
}

.home-mark view {
  position: absolute;
  width: 16rpx;
  height: 30rpx;
  background: #0a0a0a;
  transform: skewY(28deg);
}

.home-mark view:first-child {
  top: 5rpx;
  left: 5rpx;
}

.home-mark view:last-child {
  right: 5rpx;
  bottom: 5rpx;
}

.home-copy {
  margin-top: auto;
}

.home-title {
  width: 100%;
  max-width: none;
  min-width: 0;
  margin-top: 14rpx;
  font-size: 64rpx;
  font-weight: 700;
  line-height: 1.16;
}

.home-desc {
  width: 100%;
  max-width: none;
  min-width: 0;
  margin-top: 22rpx;
  color: #666666;
  font-size: 27rpx;
  line-height: 44rpx;
}

.home-actions {
  width: 100%;
  margin-top: 48rpx;
}

.home-process {
  padding: 8rpx 0 56rpx;
  border-top: 2rpx solid #dedede;
}

.home-example { margin: 0 var(--dl-gutter) 54rpx; padding: 30rpx 0 34rpx; border-top: 2rpx solid var(--dl-black); border-bottom: 2rpx solid var(--dl-black); }
.home-example__text { margin-top: 18rpx; font-size: 30rpx; line-height: 50rpx; }
.home-topics { margin: 24rpx var(--dl-gutter) 0; }
.home-topic { padding: 18rpx 0; border-bottom: 2rpx solid var(--dl-grey-200); font-size: 27rpx; line-height: 40rpx; }

.home-section-title {
  margin-top: 38rpx;
}

.home-list {
  border-top-color: #0a0a0a;
}

.home-step {
  width: 54rpx;
  flex: 0 0 54rpx;
  color: #666666;
  font-size: 24rpx;
  font-weight: 600;
}

.home-note {
  margin-top: 10rpx;
}

.home-pool-note {
  padding: 38rpx var(--dl-gutter) calc(56rpx + env(safe-area-inset-bottom));
  border-top: 2rpx solid var(--dl-grey-200);
  color: var(--dl-grey-500);
  font-size: 24rpx;
  line-height: 40rpx;
}

.sheet-copy { margin-top: 24rpx; color: var(--dl-grey-500); font-size: 27rpx; line-height: 46rpx; }
