.home-hero {
  display: flex;
  min-height: 760rpx;
  flex-direction: column;
  padding: 42rpx var(--dl-gutter) 52rpx;
}

.home-wordmark {
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: 27rpx;
  font-weight: 700;
  white-space: nowrap;
}

.home-mark {
  position: relative;
  width: 42rpx;
  height: 36rpx;
}

.home-mark__bar {
  position: absolute;
  width: 16rpx;
  height: 30rpx;
  background: #0a0a0a;
  transform: skewY(28deg);
}

.home-mark__bar--first {
  top: 5rpx;
  left: 5rpx;
}

.home-mark__bar--last {
  right: 5rpx;
  bottom: 5rpx;
}

.home-copy {
  min-width: 0;
  margin-top: auto;
}

.home-title {
  width: 100%;
  max-width: none;
  min-width: 0;
  margin-top: 14rpx;
  font-size: 64rpx;
  font-weight: 700;
  line-height: 1.16;
}

.home-desc {
  width: 100%;
  max-width: none;
  min-width: 0;
  margin-top: 22rpx;
  color: #666666;
  font-size: 27rpx;
  line-height: 44rpx;
  overflow-wrap: anywhere;
  white-space: normal;
}

.home-actions {
  width: 100%;
  margin-top: 48rpx;
}

.home-process {
  padding: 8rpx 0 56rpx;
  border-top: 2rpx solid #dedede;
}

.home-example { margin: 0 var(--dl-gutter) 54rpx; padding: 30rpx 0 34rpx; border-top: 2rpx solid var(--dl-black); border-bottom: 2rpx solid var(--dl-black); }
.home-example__text { margin-top: 18rpx; font-size: 30rpx; line-height: 50rpx; overflow-wrap: anywhere; white-space: normal; }
.home-topics { margin: 24rpx var(--dl-gutter) 0; }
.home-topic { padding: 18rpx 0; border-bottom: 2rpx solid var(--dl-grey-200); font-size: 27rpx; line-height: 40rpx; }

.home-section-title {
  margin-top: 38rpx;
}

.home-list {
  border-top-color: #0a0a0a;
}

.home-step {
  width: 54rpx;
  flex: 0 0 54rpx;
  color: #666666;
  font-size: 24rpx;
  font-weight: 600;
}

.home-note { margin-top: 10rpx; color: var(--dl-black); font-size: 25rpx; font-weight: 600; line-height: 36rpx; }

.home-progress-block { margin-top: 28rpx; padding-top: 22rpx; border-top: 2rpx solid var(--dl-grey-200); }
.home-progress-block__section { font-size: 29rpx; font-weight: 700; line-height: 42rpx; overflow-wrap: anywhere; }
.home-progress-block__detail { margin-top: 8rpx; color: var(--dl-grey-500); font-size: 24rpx; line-height: 38rpx; }
.home-progress-block__save { margin-top: 6rpx; color: var(--dl-grey-500); font-size: 23rpx; line-height: 36rpx; }

.home-restore-panel { margin: 0 var(--dl-gutter) 40rpx; padding: 24rpx 0 28rpx; border-top: 2rpx solid var(--dl-black); border-bottom: 2rpx solid var(--dl-black); }
.home-restore-panel--error { border-top-color: var(--dl-danger); }
.home-restore-panel__title { font-size: 29rpx; font-weight: 700; line-height: 42rpx; }
.home-restore-panel__body { margin-top: 10rpx; color: var(--dl-grey-500); font-size: 25rpx; line-height: 40rpx; overflow-wrap: anywhere; }
.home-restore-panel__actions { display: flex; flex-direction: column; align-items: stretch; gap: 4rpx; margin-top: 16rpx; }
.home-restore-panel__action { min-height: 80rpx; margin: 0; padding: 20rpx 0; border: 0; background: transparent; color: var(--dl-black); font-size: 25rpx; line-height: 38rpx; text-align: left; text-decoration: underline; }
.home-restore-status { margin: 0 var(--dl-gutter) 32rpx; color: var(--dl-grey-500); font-size: 24rpx; line-height: 38rpx; }

.home-pool-note {
  padding: 38rpx var(--dl-gutter) calc(56rpx + env(safe-area-inset-bottom));
  border-top: 2rpx solid var(--dl-grey-200);
  color: var(--dl-grey-500);
  font-size: 24rpx;
  line-height: 40rpx;
}

.home-sync-error { width: 100%; margin: 0; padding: 24rpx var(--dl-gutter); border: 0; border-top: 2rpx solid var(--dl-grey-200); background: transparent; color: var(--dl-danger); font-size: 24rpx; line-height: 38rpx; text-align: left; }
.home-utility-links { display: flex; justify-content: center; gap: 34rpx; padding: 10rpx var(--dl-gutter) calc(32rpx + env(safe-area-inset-bottom)); }
.home-utility-link { min-height: 88rpx; margin: 0; padding: 24rpx 0; border: 0; background: transparent; color: var(--dl-grey-500); font-size: 23rpx; line-height: 36rpx; text-decoration: underline; }
.home-utility-link--danger { color: var(--dl-danger); }
.home-page .home-sync-error {
  box-sizing: border-box;
  width: 100%;
  min-width: 100%;
  max-width: 100%;
  margin-right: 0;
  margin-left: 0;
}
.home-page .home-utility-link {
  box-sizing: border-box;
  width: auto;
  min-width: 88rpx;
  max-width: 100%;
  margin-right: 0;
  margin-left: 0;
}

.sheet-copy { margin-top: 24rpx; padding-right: var(--dl-gutter); padding-left: var(--dl-gutter); color: var(--dl-grey-500); font-size: 27rpx; line-height: 46rpx; }
