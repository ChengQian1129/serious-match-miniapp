.coding-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 56rpx 40rpx calc(80rpx + env(safe-area-inset-bottom));
  background: var(--dl-white);
  color: var(--dl-black);
}

.coding-header {
  padding-bottom: 28rpx;
  border-bottom: 2rpx solid var(--dl-black);
}

.coding-kicker,
.coding-meta,
.coding-internal,
.coding-item-status {
  color: var(--dl-grey-500);
  font-size: 22rpx;
  line-height: 34rpx;
}

.coding-title {
  margin-top: 12rpx;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.3;
}

.coding-meta { margin-top: 12rpx; }

.coding-layout {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
  margin-top: 30rpx;
}

.coding-item-list {
  width: 100%;
  max-height: 420rpx;
  border: 2rpx solid var(--dl-grey-200);
}

.coding-item {
  width: 100%;
  margin: 0;
  padding: 18rpx 20rpx;
  border: 0;
  border-bottom: 2rpx solid var(--dl-grey-200);
  border-radius: 0;
  background: var(--dl-white);
  text-align: left;
}

.coding-item--selected {
  background: var(--dl-grey-50);
}

.coding-item-id {
  font-size: 24rpx;
  font-weight: 700;
  line-height: 34rpx;
}

.coding-item-prompt {
  margin-top: 6rpx;
  font-size: 25rpx;
  line-height: 36rpx;
  overflow-wrap: anywhere;
}

.coding-item-status { margin-top: 8rpx; }

.coding-panel,
.debrief-section {
  padding-top: 28rpx;
  border-top: 2rpx solid var(--dl-black);
}

.coding-section-title {
  font-size: 30rpx;
  font-weight: 700;
  line-height: 42rpx;
}

.coding-prompt {
  margin-top: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.48;
}

.coding-internal { margin-top: 12rpx; }

.coding-field { margin-top: 28rpx; }

.coding-label {
  margin-top: 22rpx;
  color: var(--dl-grey-500);
  font-size: 23rpx;
  line-height: 34rpx;
}

.coding-options {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 10rpx;
}

.coding-option,
.coding-primary,
.coding-secondary {
  margin: 0;
  padding: 16rpx 20rpx;
  border-radius: 6rpx;
  font-size: 24rpx;
  line-height: 36rpx;
}

.coding-option,
.coding-secondary {
  border: 2rpx solid var(--dl-grey-200);
  background: var(--dl-white);
  color: var(--dl-black);
}

.coding-primary {
  border: 2rpx solid var(--dl-black);
  background: var(--dl-black);
  color: var(--dl-white);
}

.coding-input,
.coding-textarea {
  box-sizing: border-box;
  width: 100%;
  margin-top: 10rpx;
  padding: 16rpx;
  border: 0;
  border-bottom: 2rpx solid var(--dl-black);
  background: var(--dl-grey-50);
  color: var(--dl-black);
  font-size: 25rpx;
  line-height: 38rpx;
}

.coding-input { min-height: 76rpx; }
.coding-textarea { min-height: 150rpx; }

.coding-actions {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 12rpx;
  margin-top: 28rpx;
}

.coding-export {
  width: 100%;
  margin-top: 18rpx;
}

.coding-export-output {
  min-height: 360rpx;
  margin-top: 18rpx;
  font-family: monospace;
  font-size: 20rpx;
}

.coding-error,
.coding-notice {
  margin-top: 20rpx;
  padding: 16rpx 0;
  border-top: 2rpx solid var(--dl-grey-200);
  font-size: 24rpx;
  line-height: 36rpx;
}

.coding-error { color: var(--dl-danger); }
.coding-notice { color: var(--dl-grey-500); }

.coding-footer {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  gap: 12rpx;
  margin-top: 44rpx;
}

.coding-complete .coding-meta,
.coding-blocked .coding-meta {
  margin-top: 18rpx;
}

.coding-complete .coding-primary,
.coding-blocked .coding-primary {
  width: 100%;
  margin-top: 30rpx;
}
