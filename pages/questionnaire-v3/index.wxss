.product-v0-page { min-height: 100vh; padding-bottom: calc(180rpx + env(safe-area-inset-bottom)); background: #fbfbfa; }
.product-v0-shell { padding: 42rpx var(--dl-gutter) 80rpx; }
.product-v0-intro { padding-bottom: 28rpx; border-bottom: 2rpx solid var(--dl-black); }
.product-v0-kicker, .product-v0-chapter, .product-v0-count { color: var(--dl-grey-500); font-size: 23rpx; line-height: 34rpx; }
.product-v0-title { margin-top: 12rpx; font-size: 42rpx; font-weight: 700; line-height: 1.28; }
.product-v0-intro__body { margin-top: 14rpx; color: #454545; font-size: 27rpx; line-height: 43rpx; }
.product-v0-intro__note { margin-top: 12rpx; color: var(--dl-grey-500); font-size: 23rpx; line-height: 36rpx; }
.product-v0-topline { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; margin-top: 32rpx; }
.product-v0-back { margin: 0; padding: 6rpx 0; border: 0; background: transparent; color: var(--dl-black); font-size: 25rpx; }
.product-v0-chapter { flex: 1; text-align: center; }
.product-v0-count { min-width: 78rpx; text-align: right; }
.product-v0-progress { height: 6rpx; margin-top: 14rpx; overflow: hidden; background: var(--dl-grey-200); }
.product-v0-progress__bar { height: 100%; background: var(--dl-black); transition: width 220ms ease; }
.product-v0-task { padding-top: 54rpx; animation: product-v0-in 280ms ease both; }
.product-v0-task.motion-back { animation-name: product-v0-back-in; }
.product-v0-question { font-size: 39rpx; font-weight: 700; line-height: 1.42; }
.product-v0-item { margin-top: 34rpx; }
.product-v0-item__prompt { margin-bottom: 14rpx; color: var(--dl-grey-500); font-size: 25rpx; line-height: 38rpx; }
.product-v0-options { border-top: 2rpx solid var(--dl-black); }
.product-v0-option { display: flex; width: 100%; min-height: 76rpx; align-items: center; gap: 18rpx; margin: 0; padding: 16rpx 0; border: 0; border-bottom: 2rpx solid var(--dl-grey-200); border-radius: 0; background: transparent; color: var(--dl-black); font-size: 27rpx; line-height: 39rpx; text-align: left; }
.product-v0-option__dot { width: 28rpx; flex: 0 0 28rpx; color: var(--dl-grey-500); text-align: center; }
.product-v0-option--selected { font-weight: 600; }
.product-v0-option--selected .product-v0-option__dot { color: var(--dl-black); }
.product-v0-input { width: 100%; min-height: 84rpx; box-sizing: border-box; padding: 18rpx 20rpx; border: 2rpx solid var(--dl-grey-300); border-radius: 0; background: #fff; font-size: 28rpx; }
.product-v0-skip { min-height: 52rpx; margin: 10rpx 0 0; padding: 8rpx 0; border: 0; background: transparent; color: var(--dl-grey-500); font-size: 23rpx; text-align: left; text-decoration: underline; }
.product-v0-actions { display: block; }
@keyframes product-v0-in { from { opacity: 0; transform: translateY(12rpx); } to { opacity: 1; transform: translateY(0); } }
@keyframes product-v0-back-in { from { opacity: 0; transform: translateX(-16rpx); } to { opacity: 1; transform: translateX(0); } }
@media (max-width: 360px) { .product-v0-shell { padding-top: 28rpx; } .product-v0-title { font-size: 34rpx; } .product-v0-question { font-size: 31rpx; } .product-v0-option { font-size: 25rpx; } }
