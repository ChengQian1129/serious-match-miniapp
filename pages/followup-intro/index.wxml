<view class="page followup-intro">
  <view class="page-header">
    <view class="page-kicker">{{copy.kicker}}</view>
    <view class="page-title">{{copy.title}}</view>
    <view class="page-desc followup-copy-text">{{copy.body}}</view>
  </view>
  <view class="followup-safety">{{copy.safety}}</view>
  <view class="dl-stack followup-actions"><button class="dl-button" bind:tap="continue">{{hasRegistration ? '管理联系资料' : copy.primary}}</button><button class="dl-button dl-button--outline" bind:tap="defer">{{copy.secondary}}</button></view>
</view>
