<view wx:if="{{isReady}}" class="page page--with-action result-page result-page--enter">
  <view class="result-header">
    <view class="page-kicker">你的初步关系倾向</view>
    <view class="result-title">{{result.title}}</view>
    <view class="result-intro">{{result.intro}}</view>
  </view>

  <view class="result-body">
    <view wx:for="{{result.sections}}" wx:key="label" class="result-section">
      <view class="result-section__label">{{item.label}}</view>
      <view class="result-section__text">{{item.text}}</view>
    </view>

    <view class="result-boundary">
      <view class="result-boundary__mark">{{result.version === '0.2.0' ? '05' : '04'}}</view>
      <view class="result-boundary__text">{{result.note}}</view>
    </view>

    <button wx:if="{{!isSaved}}" class="result-restart" bind:tap="restartExploration">重新回答这 5 个问题</button>
  </view>
</view>

<view wx:else class="page result-empty">
  <view class="page-kicker">关系底图</view>
  <view class="page-title">还没有形成初步结果</view>
  <view class="page-desc">完成 5 个选择后，这里会出现一份简短的关系偏好描述。</view>
  <button class="dl-button result-empty__button" bind:tap="restartExploration">开始回答</button>
</view>

<view wx:if="{{isReady}}" class="action-bar action-bar--stack result-actions">
  <button class="dl-button" loading="{{isSaving}}" disabled="{{isSaving}}" bind:tap="handleSave">{{isSaved ? '返回我的关系底图' : isSaving ? '正在保存' : '保存结果并继续'}}</button>
  <button wx:if="{{!isSaved}}" class="result-leave" bind:tap="handleLeave">暂时离开</button>
  <view wx:if="{{cloudError}}" class="result-save-error">{{cloudError}}</view>
</view>
