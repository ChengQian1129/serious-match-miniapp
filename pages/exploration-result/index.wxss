.result-page {
  padding-bottom: calc(248rpx + env(safe-area-inset-bottom));
}

.result-page--enter {
  animation: result-enter 180ms cubic-bezier(0.25, 1, 0.5, 1) both;
}

@keyframes result-enter {
  from {
    opacity: 0;
    transform: translateY(12rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.result-header {
  padding: 78rpx 40rpx 58rpx;
  border-bottom: 2rpx solid var(--dl-black);
}

.result-title {
  max-width: 650rpx;
  margin-top: 18rpx;
  font-size: 54rpx;
  font-weight: 700;
  line-height: 1.22;
}

.result-intro {
  margin-top: 34rpx;
  font-size: 31rpx;
  line-height: 50rpx;
}

.result-body {
  padding: 0 40rpx 64rpx;
}

.result-section {
  padding: 46rpx 0 48rpx;
  border-bottom: 2rpx solid var(--dl-grey-200);
}

.result-section__label {
  color: var(--dl-grey-500);
  font-size: 23rpx;
  font-weight: 600;
  line-height: 34rpx;
}

.result-section__text {
  margin-top: 14rpx;
  font-size: 30rpx;
  line-height: 49rpx;
}

.result-boundary {
  display: grid;
  grid-template-columns: 68rpx 1fr;
  gap: 22rpx;
  margin-top: 46rpx;
  padding: 32rpx 0;
  border-top: 2rpx solid var(--dl-black);
  border-bottom: 2rpx solid var(--dl-black);
}

.result-boundary__mark {
  color: var(--dl-grey-500);
  font-size: 24rpx;
  font-weight: 600;
  line-height: 40rpx;
}

.result-boundary__text {
  font-size: 27rpx;
  line-height: 42rpx;
}

.result-restart,
.result-leave {
  display: flex;
  width: 100%;
  align-items: center;
  justify-content: center;
  margin: 0;
  border: 0;
  background: transparent;
  color: var(--dl-black);
  font-size: 25rpx;
  line-height: 36rpx;
  text-decoration: underline;
}

.result-restart {
  min-height: 92rpx;
  margin-top: 18rpx;
}

.result-actions {
  padding-top: 20rpx;
}

.result-leave {
  min-height: 58rpx;
  text-decoration: none;
}

.result-save-error {
  margin-top: 4rpx;
  color: var(--dl-danger);
  font-size: 22rpx;
  line-height: 32rpx;
  text-align: center;
}

.result-empty {
  padding: 108rpx 40rpx 64rpx;
}

.result-empty__button {
  margin-top: 54rpx;
}

@media (max-width: 360px) {
  .result-header {
    padding-top: 54rpx;
    padding-bottom: 40rpx;
  }

  .result-title {
    font-size: 26px;
    line-height: 1.24;
  }

  .result-intro,
  .result-section__text {
    font-size: 16px;
    line-height: 25px;
  }

  .result-boundary {
    display: block;
  }

  .result-boundary__text {
    margin-top: 8rpx;
  }
}
