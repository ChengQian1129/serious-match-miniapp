.followup-profile { padding-bottom: calc(300rpx + env(safe-area-inset-bottom)); }
.followup-copy-text { white-space: pre-line; }
.followup-form { margin: 0 var(--dl-gutter); }
.followup-form .dl-input-wrap + .dl-input-wrap { margin-top: 16rpx; }
.contact-channel-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16rpx; margin-top: 14rpx; }
.contact-channel { min-height: 88rpx; margin: 0; padding: 18rpx 12rpx; border: 2rpx solid var(--dl-grey-200); border-radius: 4rpx; background: var(--dl-white); color: var(--dl-black); font-size: 25rpx; line-height: 44rpx; }
.contact-channel::after { border: 0; }
.contact-channel--pressed { opacity: .68; }
.contact-channel--selected { border-color: var(--dl-black); background: var(--dl-black); color: var(--dl-white); }
.contact-value-wrap { animation: contact-field-in 180ms ease-out both; }
.dl-input-hint { margin-top: 12rpx; color: var(--dl-grey-500); font-size: 22rpx; line-height: 34rpx; }
.type-list { display: flex; flex-direction: column; gap: 14rpx; }
.type-list .choice-option { margin: 0; }
.dl-textarea { min-height: 180rpx; height: auto; padding-top: 28rpx; }
.action-bar .dl-button + .dl-button { margin-top: 10rpx; }
@keyframes contact-field-in { from { opacity: 0; transform: translateY(-8rpx); } to { opacity: 1; transform: translateY(0); } }
