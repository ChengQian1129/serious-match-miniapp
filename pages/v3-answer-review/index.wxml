<view wx:if="{{ready && !emptyState}}" class="page v3-answer-review-page">
  <view class="v3-answer-review-shell">
    <button class="v3-text-action" bind:tap="back">{{copy.preview.backAction}}</button>
    <view class="v3-answer-review-kicker">{{copy.preview.answerReviewTitle}}</view>
    <view class="v3-answer-review-title">{{copy.preview.answerReviewTitle}}</view>
    <view class="v3-answer-review-notice">{{completedSectionsLabel}} · 修改后会重新计算结果。</view>

    <view class="v3-answer-review-list">
      <view wx:for="{{sections}}" wx:key="id" wx:for-item="section" class="v3-review-section {{section.status === 'locked' ? 'v3-review-section--locked' : ''}}">
        <button class="v3-review-section__header" data-section-id="{{section.id}}" bind:tap="toggleSection" aria-expanded="{{section.expanded}}">
          <view class="v3-review-section__topline"><text>{{section.sectionNumber}} / {{section.sectionCount}}</text><text>{{section.progressText}}</text></view>
          <view class="v3-review-section__title">{{section.title}}</view>
          <view class="v3-review-section__description">{{section.description}}</view>
          <text class="v3-review-section__chevron">{{section.expanded ? '⌃' : '›'}}</text>
        </button>
        <view wx:if="{{section.expanded}}" class="v3-review-items">
          <view wx:for="{{section.items}}" wx:key="itemId" wx:for-item="item" class="v3-review-item">
            <view class="v3-review-item__prompt">{{item.prompt}}</view>
            <view class="v3-review-item__answer {{item.hasAnswer ? '' : 'v3-review-item__answer--missing'}}">{{item.answer}}</view>
            <button class="v3-review-item__edit" data-task-id="{{item.taskId}}" bind:tap="editItem">{{copy.home.editAction}} <text>›</text></button>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>

<view wx:if="{{ready && emptyState}}" class="page v3-answer-review-empty">
  <view class="v3-answer-review-empty__title">{{copy.home.readyNewTitle}}</view>
  <view class="v3-answer-review-empty__body">{{copy.home.readyNewDescription}}</view>
  <button class="dl-button" bind:tap="goHome">{{copy.questionnaire.homeAction}}</button>
</view>
