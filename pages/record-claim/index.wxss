.claim-page {
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

.claim-enter {
  animation: claim-enter 180ms cubic-bezier(0.25, 1, 0.5, 1) both;
}

@keyframes claim-enter {
  from { opacity: 0; transform: translateX(16rpx); }
  to { opacity: 1; transform: translateX(0); }
}

.claim-header {
  padding: 58rpx var(--dl-gutter) 54rpx;
  border-bottom: 2rpx solid var(--dl-black);
}

.claim-back {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  color: var(--dl-grey-500);
  font-size: 24rpx;
  line-height: 36rpx;
  text-align: left;
}

.claim-back text { color: var(--dl-black); font-size: 36rpx; line-height: 32rpx; }
.claim-title { margin-top: 30rpx; font-size: 44rpx; font-weight: 700; line-height: 1.3; }
.claim-text { margin-top: 22rpx; font-size: 29rpx; line-height: 48rpx; white-space: pre-line; }
.claim-boundary { margin-top: 28rpx; padding-top: 20rpx; border-top: 2rpx solid var(--dl-grey-200); color: var(--dl-grey-500); font-size: 24rpx; line-height: 38rpx; }

.claim-section { padding: 0 var(--dl-gutter); }
.claim-evidence-toggle { display: flex; width: 100%; align-items: center; justify-content: space-between; margin: 0; padding: 30rpx 0; border: 0; border-bottom: 2rpx solid var(--dl-grey-200); border-radius: 0; background: transparent; color: var(--dl-black); font-size: 27rpx; line-height: 40rpx; text-align: left; }
.claim-evidence-toggle .dl-chevron { color: var(--dl-grey-500); font-size: 34rpx; }
.claim-evidence-panel { padding-bottom: 18rpx; }
.claim-evidence-group { padding-top: 26rpx; }
.claim-evidence-group__title { color: var(--dl-grey-500); font-size: 23rpx; line-height: 36rpx; }
.claim-evidence { padding: 22rpx 0; border-bottom: 2rpx solid var(--dl-grey-200); }
.claim-evidence__question { font-size: 26rpx; line-height: 42rpx; }
.claim-evidence__answer { margin-top: 8rpx; color: var(--dl-grey-500); font-size: 25rpx; line-height: 38rpx; }

.claim-actions { gap: 18rpx; }
.claim-back-action { display: block; width: 100%; margin: 0; padding: 16rpx 0; border: 0; border-radius: 0; background: transparent; color: var(--dl-grey-500); font-size: 25rpx; line-height: 40rpx; }

@media (max-width: 360px) {
  .claim-header { padding-top: 46rpx; padding-bottom: 44rpx; }
  .claim-section { padding-right: var(--dl-gutter); padding-left: var(--dl-gutter); }
  .claim-title { font-size: 34px; }
  .claim-text { font-size: 16px; line-height: 26px; }
}
