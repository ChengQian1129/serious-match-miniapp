<view class="question-page" style="padding-top: {{statusBarHeight}}px;">
  <view class="question-top"><view class="question-top__row"><button class="question-back" aria-label="返回上一题" bind:tap="handlePrevious"><text class="question-back__icon">‹</text>返回</button><view class="question-top__title">{{isEditing ? '编辑资料' : '创建资料'}}</view><view class="question-top__spacer"></view></view><view class="question-progress-row"><view class="question-progress"><view class="question-progress__bar" style="transform: scaleX({{progress}});"></view></view><text class="question-top__count">{{questionNumber}} / 29</text></view></view>
  <view class="question-content {{motionClass}}"><view class="question-eyebrow">现实安排</view>
    <block wx:if="{{currentQuestion === 0}}"><view class="question-title">通常什么时候方便见面？</view><view class="question-desc">可以选择多个时间段。</view><view class="question-control choice-list"><button wx:for="{{meetingTimeOptions}}" wx:key="value" class="choice-option {{item.selected ? 'choice-option--selected' : ''}}" data-value="{{item.value}}" bind:tap="toggleMeetingTime"><text>{{item.label}}</text><text wx:if="{{item.selected}}" class="choice-option__check">✓</text></button></view></block>
    <block wx:elif="{{currentQuestion === 1}}"><view class="question-title">能接受怎样的见面通勤？</view><view class="question-desc">只需要给出当前大致边界。</view><view class="question-control choice-list"><button wx:for="{{commuteOptions}}" wx:key="value" class="choice-option {{form.commuteTolerance === item.value ? 'choice-option--selected' : ''}}" data-field="commuteTolerance" data-value="{{item.value}}" bind:tap="chooseOption"><text>{{item.label}}</text><text wx:if="{{form.commuteTolerance === item.value}}" class="choice-option__check">✓</text></button></view></block>
    <block wx:elif="{{currentQuestion === 2}}"><view class="question-title">你平时的工作和作息更接近？</view><view class="question-desc">不用于评价生活方式，只判断时间是否容易协调。</view><view class="question-control choice-list"><button wx:for="{{scheduleOptions}}" wx:key="value" class="choice-option {{form.schedulePattern === item.value ? 'choice-option--selected' : ''}}" data-field="schedulePattern" data-value="{{item.value}}" bind:tap="chooseOption"><text>{{item.label}}</text><text wx:if="{{form.schedulePattern === item.value}}" class="choice-option__check">✓</text></button></view></block>
    <block wx:elif="{{currentQuestion === 3}}"><view class="question-title">对结婚时间有什么期待？</view><view class="question-desc">这是当前计划，不是对未来的承诺。</view><view class="question-control choice-list"><button wx:for="{{marriageTimelineOptions}}" wx:key="value" class="choice-option {{form.marriageTimeline === item.value ? 'choice-option--selected' : ''}}" data-field="marriageTimeline" data-value="{{item.value}}" bind:tap="chooseOption"><text>{{item.label}}</text><text wx:if="{{form.marriageTimeline === item.value}}" class="choice-option__check">✓</text></button></view></block>
    <block wx:elif="{{currentQuestion === 4}}"><view class="question-title">怎么看待与父母同住？</view><view class="question-desc">用于提前识别长期生活安排。</view><view class="question-control choice-list"><button wx:for="{{parentCohabitationOptions}}" wx:key="value" class="choice-option {{form.parentCohabitation === item.value ? 'choice-option--selected' : ''}}" data-field="parentCohabitation" data-value="{{item.value}}" bind:tap="chooseOption"><text>{{item.label}}</text><text wx:if="{{form.parentCohabitation === item.value}}" class="choice-option__check">✓</text></button></view></block>
    <block wx:elif="{{currentQuestion === 5}}"><view class="question-title">更倾向怎样管理共同财务？</view><view class="question-desc">只记录立场，不询问收入和资产。</view><view class="question-control choice-list"><button wx:for="{{financeOptions}}" wx:key="value" class="choice-option {{form.financeStyle === item.value ? 'choice-option--selected' : ''}}" data-field="financeStyle" data-value="{{item.value}}" bind:tap="chooseOption"><text>{{item.label}}</text><text wx:if="{{form.financeStyle === item.value}}" class="choice-option__check">✓</text></button></view></block>
    <block wx:elif="{{currentQuestion === 6}}"><view class="question-title">更倾向怎样分担家务？</view><view class="question-desc">选择目前最接近的想法。</view><view class="question-control choice-list"><button wx:for="{{houseworkOptions}}" wx:key="value" class="choice-option {{form.houseworkStyle === item.value ? 'choice-option--selected' : ''}}" data-field="houseworkStyle" data-value="{{item.value}}" bind:tap="chooseOption"><text>{{item.label}}</text><text wx:if="{{form.houseworkStyle === item.value}}" class="choice-option__check">✓</text></button></view></block>
    <block wx:elif="{{currentQuestion === 7}}"><view class="question-title">对共同生活中的宠物怎么看？</view><view class="question-desc">过敏等具体情况可以之后补充。</view><view class="question-control choice-list"><button wx:for="{{petOptions}}" wx:key="value" class="choice-option {{form.petAcceptance === item.value ? 'choice-option--selected' : ''}}" data-field="petAcceptance" data-value="{{item.value}}" bind:tap="chooseOption"><text>{{item.label}}</text><text wx:if="{{form.petAcceptance === item.value}}" class="choice-option__check">✓</text></button></view></block>
    <block wx:elif="{{currentQuestion === 8}}"><view class="question-title">对饮酒习惯的边界是？</view><view class="question-desc">只用于现实生活习惯核对。</view><view class="question-control choice-list"><button wx:for="{{alcoholOptions}}" wx:key="value" class="choice-option {{form.alcoholAcceptance === item.value ? 'choice-option--selected' : ''}}" data-field="alcoholAcceptance" data-value="{{item.value}}" bind:tap="chooseOption"><text>{{item.label}}</text><text wx:if="{{form.alcoholAcceptance === item.value}}" class="choice-option__check">✓</text></button></view></block>
    <block wx:else><view class="question-title">你更习惯怎样的社交节奏？</view><view class="question-desc">不同节奏不代表不合适，只需要提前了解。</view><view class="question-control choice-list"><button wx:for="{{socialOptions}}" wx:key="value" class="choice-option {{form.socialRhythm === item.value ? 'choice-option--selected' : ''}}" data-field="socialRhythm" data-value="{{item.value}}" bind:tap="chooseOption"><text>{{item.label}}</text><text wx:if="{{form.socialRhythm === item.value}}" class="choice-option__check">✓</text></button></view></block>
  </view>
</view>
<view class="action-bar"><button class="dl-button" disabled="{{!canContinue}}" bind:tap="handleContinue">{{continueLabel}}</button></view>
