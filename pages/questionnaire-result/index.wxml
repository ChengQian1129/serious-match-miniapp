<view wx:if="{{report}}" class="page report-page" style="padding-top: {{statusBarHeight}}px;">
  <view class="report-header">
    <view class="page-kicker">你的关系说明书</view>
    <view wx:if="{{heroClaim}}" class="report-hero">
      <view class="report-title">{{heroClaim.title}}</view>
      <view class="report-hero__text">{{heroClaim.text}}</view>
    </view>
    <view class="report-intro">{{heroIntro}}</view>
  </view>

  <view class="report-body">
    <view wx:for="{{sections}}" wx:key="id" class="report-section">
      <view class="report-section__title">{{item.title}}</view>
      <view wx:for="{{item.claims}}" wx:key="id" class="report-claim" data-id="{{item.id}}" bind:tap="openClaim">
        <view class="report-claim__title">{{item.title}}</view>
        <view class="report-claim__text">{{item.text}}</view>
        <view class="report-claim__meta">{{item.confirmationLabel || claimAction}} <text class="dl-chevron">›</text></view>
      </view>
    </view>

    <view wx:if="{{observations.length}}" class="report-section report-observation">
      <view class="report-section__title">{{observationTitle}}</view>
      <view wx:for="{{observations}}" wx:key="id" class="report-claim" data-id="{{item.id}}" bind:tap="openClaim">
        <view class="report-claim__title">{{item.title}}</view>
        <view class="report-claim__text">{{item.text}}</view>
        <view class="report-claim__meta">{{claimAction}} <text class="dl-chevron">›</text></view>
      </view>
    </view>

    <view wx:if="{{unknowns.length}}" class="report-unknowns">
      <view class="report-section__title">{{unknownTitle}}</view>
      <view class="report-unknowns__description">{{unknownDescription}}</view>
      <view wx:for="{{unknowns}}" wx:key="id" class="report-unknown"><view class="report-unknown__title">{{item.title}}</view><view>{{item.text}}</view></view>
    </view>

    <view class="report-boundary">{{boundaryCopy}}</view>

    <view class="report-revise-block">
      <view class="report-section__title">{{reviseTitle}}</view>
      <view class="report-chapters"><button wx:for="{{chapters}}" wx:key="id" class="report-chapter" data-chapter="{{item.id}}" bind:tap="reviseChapter"><text>{{item.id}}</text><text>{{item.title}}</text></button></view>
    </view>

    <view wx:if="{{showFollowup}}" class="report-followup">
      <view class="report-followup__title">{{followupTitle}}</view>
      <view class="report-followup__body">{{followupBody}}</view>
      <button class="report-followup__button" bind:tap="openFollowup">{{followupAction}}</button>
    </view>

    <view class="report-data">
      <view class="report-section__title">{{dataTitle}}</view>
      <button class="report-data__delete" disabled="{{isDeleting}}" bind:tap="requestDeleteReport">{{dataDelete}}</button>
      <button class="dl-button dl-button--outline" bind:tap="openMap">{{mapAction}}</button>
    </view>

    <t-dialog visible="{{showDeleteDialog}}" title="{{deleteDialogTitle}}" content="{{deleteDialogContent}}" confirm-btn="{{deleteConfirmButton}}" cancel-btn="{{deleteDialogCancel}}" bind:confirm="confirmDeleteReport" bind:cancel="cancelDeleteReport" bind:close="cancelDeleteReport" />
  </view>
</view>
<view wx:else class="page result-empty"><view class="page-kicker">关系说明书</view><view class="page-title">还没有完成这次探索</view><button class="dl-button result-empty__button" bind:tap="revise">继续回答</button></view>
