<view wx:if="{{report}}" class="page report-page" style="padding-top: {{statusBarHeight}}px;">
  <view class="report-header"><view class="page-kicker">关系说明书 · {{report.reportVersion}}.0</view><view class="report-title">{{report.title}}</view><view class="report-subtitle">{{report.subtitle}}</view></view>
  <view class="report-body">
    <view wx:for="{{sections}}" wx:key="id" class="report-section">
      <view class="report-section__title">{{item.title}}</view>
      <view wx:for="{{item.claims}}" wx:key="id" class="report-claim" data-id="{{item.id}}" bind:tap="openClaim">
        <view class="report-claim__title">{{item.title}}</view><view class="report-claim__text">{{item.text}}</view><view class="report-claim__meta">{{item.evidence.length}} 项依据 · {{item.confirmationLabel || (item.confidenceState === 'multi_item_supported' ? '多题支持' : '初步判断')}} <text class="dl-chevron">›</text></view>
      </view>
    </view>
    <view wx:if="{{unknowns.length}}" class="report-unknowns"><view class="report-section__title">目前还不知道什么</view><view wx:for="{{unknowns}}" wx:key="id" class="report-unknown"><view class="report-unknown__title">{{item.title}}</view><view>{{item.text}}</view></view></view>
    <view class="report-boundary">这份报告来自你的当前自述。它能帮助你整理关系需要，但不能替代真实相处，也不能预测一段关系一定成功。</view>
    <view wx:if="{{shareFragments.length}}" class="report-share"><view class="report-section__title">可以分享的相处线索</view><view wx:for="{{shareFragments}}" wx:key="*this" class="report-share__item">{{item}}</view></view>
    <button class="dl-button report-share-button" bind:tap="openShare">生成我的相处名片{{shareableCount ? ' · ' + shareableCount + ' 条已核对' : ''}}</button>
    <view class="report-revise-block"><view class="report-section__title">修改某一章的回答</view><view class="report-chapters"><button wx:for="{{chapters}}" wx:key="id" class="report-chapter" data-chapter="{{item.id}}" bind:tap="reviseChapter"><text>{{item.id}}</text><text>{{item.title}}</text></button></view></view>
    <button class="dl-button dl-button--outline" bind:tap="openMap">把报告用于认真匹配</button>
  </view>
</view>
<view wx:else class="page result-empty"><view class="page-kicker">关系说明书</view><view class="page-title">还没有完成这次探索</view><button class="dl-button result-empty__button" bind:tap="revise">继续回答</button></view>
