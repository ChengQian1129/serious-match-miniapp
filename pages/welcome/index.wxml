<view class="welcome-page" style="padding-top: {{statusBarHeight}}px;">
  <view class="welcome-head">
    <view class="welcome-brand">
      <view class="welcome-brand__symbol"><view></view><view></view></view>
    </view>
  </view>

  <view class="welcome-copy">
    <view class="welcome-title">{{welcome.title}}</view>
    <view class="welcome-body">
      <view class="welcome-body__intro">{{welcome.intro}}</view>
      <view wx:for="{{welcome.questions}}" wx:key="*this" class="welcome-question">{{item}}</view>
      <view class="welcome-body__boundary">{{welcome.boundary}}</view>
      <view wx:if="{{welcome.closing}}" class="welcome-body__closing">{{welcome.closing}}</view>
    </view>
    <view class="welcome-meta">{{welcome.meta}}</view>
  </view>

  <view class="welcome-actions">
    <button class="welcome-primary" bind:tap="begin">{{welcome.action}}<text class="welcome-primary__arrow">↗</text></button>
    <button class="welcome-method" bind:tap="openMethod">{{welcome.methodAction}}</button>
  </view>
</view>

<t-popup placement="bottom" visible="{{showMethod}}" bind:visible-change="handleMethodVisibleChange">
  <view class="sheet-content welcome-method-sheet">
    <view class="sheet-title">{{guide.title}}</view>
    <view class="sheet-copy welcome-method-sheet__copy">{{guide.body}}</view>
    <view class="sheet-copy welcome-method-sheet__focus">{{guide.focus}}</view>
    <view class="sheet-action"><button class="dl-button" bind:tap="closeMethod">{{guide.closeAction}}</button></view>
  </view>
</t-popup>
