.welcome-page {
  --ink: #24172d;
  --paper: #fbf5ec;
  display: flex;
  min-height: 100vh;
  box-sizing: border-box;
  flex-direction: column;
  padding: 28rpx 40rpx calc(30rpx + env(safe-area-inset-bottom));
  overflow: hidden;
  color: var(--ink);
  background: var(--paper);
}

.welcome-page--1 { --ink: #123b3d; --paper: #f3f1e9; }
.welcome-page--2 { --ink: #27194b; --paper: #f8f0eb; }

.welcome-head { display: flex; align-items: center; justify-content: space-between; height: 58rpx; }
.welcome-brand { display: flex; align-items: center; gap: 14rpx; font-size: 25rpx; font-weight: 700; letter-spacing: 1rpx; }
.welcome-brand__symbol { position: relative; width: 34rpx; height: 30rpx; }
.welcome-brand__symbol view { position: absolute; width: 15rpx; height: 26rpx; background: var(--ink); transform: skewY(-28deg); }
.welcome-brand__symbol view:first-child { top: 2rpx; left: 1rpx; }
.welcome-brand__symbol view:last-child { right: 1rpx; bottom: 1rpx; opacity: .35; }
.welcome-count { color: var(--ink); opacity: .58; font-size: 21rpx; letter-spacing: 2rpx; }

.welcome-visual { position: relative; flex: 1 1 auto; min-height: 650rpx; margin: 22rpx -40rpx 0; overflow: hidden; animation: visual-in 700ms cubic-bezier(.2,.8,.2,1) both; }
.welcome-image { position: absolute; width: 100%; height: 100%; }
.welcome-image--self { transform: scale(1.08); }
.welcome-image--path { transform: scale(1.04); }
.welcome-image--map { transform: scale(1.08); }
.welcome-visual__veil { position: absolute; right: 0; bottom: 0; left: 0; height: 35%; background: linear-gradient(to bottom, rgba(31,18,32,0), var(--paper)); opacity: .9; }
.welcome-page--1 .welcome-visual__veil { background: linear-gradient(to bottom, rgba(243,241,233,0), var(--paper)); }
.welcome-page--2 .welcome-visual__veil { background: linear-gradient(to bottom, rgba(248,240,235,0), var(--paper)); }
.welcome-stamp { position: absolute; top: 32rpx; right: 34rpx; color: rgba(255,255,255,.78); font-size: 20rpx; font-weight: 700; letter-spacing: 5rpx; line-height: 30rpx; text-align: right; }

.welcome-copy { position: relative; margin-top: -18rpx; animation: copy-in 650ms 120ms cubic-bezier(.2,.8,.2,1) both; }
.welcome-kicker { margin-bottom: 12rpx; color: var(--ink); opacity: .58; font-size: 21rpx; font-weight: 700; letter-spacing: 2rpx; text-transform: uppercase; }
.welcome-title { max-width: 610rpx; font-size: 52rpx; font-weight: 700; letter-spacing: 0; line-height: 1.16; }
.welcome-desc { max-width: 650rpx; margin-top: 18rpx; color: var(--ink); opacity: .72; font-size: 27rpx; line-height: 44rpx; }
.welcome-meta { margin-top: 16rpx; color: var(--ink); opacity: .45; font-size: 20rpx; line-height: 32rpx; }

.welcome-controls { margin-top: 28rpx; }
.welcome-dots { display: flex; gap: 10rpx; align-items: center; }
.welcome-dot { width: 28rpx; height: 5rpx; background: var(--ink); opacity: .2; transition: width 240ms ease-out, opacity 240ms ease-out; }
.welcome-dot--active { width: 66rpx; opacity: .9; }
.welcome-actions { display: flex; align-items: center; justify-content: space-between; margin-top: 22rpx; }
.welcome-skip { margin: 0; padding: 14rpx 0; border: 0; background: transparent; color: var(--ink); opacity: .55; font-size: 24rpx; line-height: 40rpx; }
.welcome-next { display: flex; align-items: center; justify-content: center; min-width: 218rpx; margin: 0; padding: 16rpx 24rpx 16rpx 30rpx; border: 0; border-radius: 0; color: var(--paper); background: var(--ink); font-size: 26rpx; font-weight: 700; line-height: 40rpx; }
.welcome-next__arrow { margin-left: 18rpx; font-size: 34rpx; line-height: 34rpx; }

@keyframes visual-in { from { opacity: 0; transform: translateY(28rpx) scale(1.015); } to { opacity: 1; transform: translateY(0) scale(1); } }
@keyframes copy-in { from { opacity: 0; transform: translateY(20rpx); } to { opacity: 1; transform: translateY(0); } }
@media (prefers-reduced-motion: reduce) { .welcome-visual, .welcome-copy { animation: none; } }
@media (max-width: 360px) { .welcome-page { padding-right: 32rpx; padding-left: 32rpx; } .welcome-visual { margin-right: -32rpx; margin-left: -32rpx; min-height: 570rpx; } .welcome-title { font-size: 46rpx; } .welcome-desc { font-size: 25rpx; line-height: 40rpx; } }
