.chapter-insight-page {
  min-height: 100vh;
  padding: 56rpx 40rpx calc(248rpx + env(safe-area-inset-bottom));
}

.chapter-insight {
  animation: insight-in 360ms cubic-bezier(.2, .8, .2, 1) both;
}

.chapter-insight__back {
  display: flex;
  align-items: center;
  margin: 0 0 42rpx;
  padding: 0;
  border: 0;
  background: transparent;
  color: var(--dl-grey-500);
  font-size: 25rpx;
  line-height: 36rpx;
}

.chapter-insight__back text {
  margin-right: 6rpx;
  color: var(--dl-black);
  font-size: 36rpx;
  line-height: 1;
}

.chapter-insight__chapter {
  margin-top: 16rpx;
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.28;
  overflow-wrap: anywhere;
}

.chapter-insight__headline {
  margin-top: 54rpx;
  padding-top: 28rpx;
  border-top: 2rpx solid var(--dl-black);
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.38;
  overflow-wrap: anywhere;
}

.chapter-insight__summary {
  margin-top: 22rpx;
  font-size: 29rpx;
  line-height: 49rpx;
  white-space: pre-line;
  overflow-wrap: anywhere;
}

.chapter-insight__evidence {
  margin-top: 50rpx;
  border-top: 2rpx solid var(--dl-grey-200);
}

.chapter-insight__evidence-toggle {
  display: flex;
  width: 100%;
  min-height: 82rpx;
  align-items: center;
  justify-content: space-between;
  margin: 0;
  padding: 18rpx 0;
  border: 0;
  background: transparent;
  color: var(--dl-black);
  font-size: 27rpx;
  font-weight: 600;
  line-height: 40rpx;
  text-align: left;
}

.chapter-insight__evidence-toggle .dl-chevron {
  color: var(--dl-grey-500);
  font-size: 32rpx;
}

.chapter-insight__evidence-list {
  padding-bottom: 12rpx;
  border-top: 2rpx solid var(--dl-grey-200);
}

.chapter-insight__evidence-label {
  padding: 22rpx 0 8rpx;
  color: var(--dl-grey-500);
  font-size: 23rpx;
  line-height: 36rpx;
}

.chapter-insight__evidence-item {
  padding: 20rpx 0;
  border-bottom: 2rpx solid var(--dl-grey-200);
  font-size: 25rpx;
  line-height: 38rpx;
}

.chapter-insight__evidence-question {
  overflow-wrap: anywhere;
}

.chapter-insight__evidence-answer {
  margin-top: 8rpx;
  color: var(--dl-grey-500);
}

.chapter-insight__actions {
  margin-top: 0;
}

.chapter-insight__later {
  width: 100%;
  margin: 14rpx 0 0;
  padding: 16rpx;
  border: 0;
  background: transparent;
  color: var(--dl-grey-500);
  font-size: 25rpx;
  line-height: 36rpx;
}

@keyframes insight-in {
  from { opacity: 0; transform: translateY(22rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@media (max-width: 360px) {
  .chapter-insight-page { padding-top: 42rpx; }
  .chapter-insight__chapter { font-size: 33px; }
  .chapter-insight__headline { margin-top: 40rpx; font-size: 28px; }
  .chapter-insight__summary { font-size: 16px; line-height: 25px; }
}
