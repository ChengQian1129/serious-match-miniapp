.questionnaire-content {
  padding-top: 62rpx;
}

.questionnaire-meta {
  display: flex;
  min-height: 36rpx;
  align-items: flex-start;
}

.questionnaire-title {
  font-size: 42rpx;
  line-height: 1.38;
}

.questionnaire-options {
  margin-top: 36rpx;
}

.questionnaire-option {
  min-height: 88rpx;
  padding: 17rpx 24rpx;
}

.questionnaire-option__number {
  width: 34rpx;
  flex: 0 0 34rpx;
  color: var(--dl-grey-500);
  font-size: 23rpx;
}

.choice-option--selected .questionnaire-option__number {
  color: #bcbcbc;
}

.questionnaire-option__label {
  min-width: 0;
  flex: 1;
}

.questionnaire-specials {
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 2rpx solid var(--dl-grey-100);
}

@media (max-width: 360px) {
  .questionnaire-content {
    padding-top: 42rpx;
  }

  .questionnaire-title {
    font-size: 22px;
  }

  .questionnaire-options {
    margin-top: 26rpx;
  }

  .questionnaire-option {
    min-height: 48px;
  }
}

@media (max-width: 360px) and (max-height: 650px) {
  .questionnaire-content {
    padding-top: 30rpx;
  }

  .questionnaire-title {
    margin-top: 6rpx;
    font-size: 20px;
    line-height: 1.3;
  }

  .questionnaire-content .question-desc {
    margin-top: 8rpx;
    font-size: 13px;
    line-height: 19px;
  }

  .questionnaire-options {
    margin-top: 18rpx;
  }

  .questionnaire-option {
    min-height: 42px;
    padding-top: 10rpx;
    padding-bottom: 10rpx;
  }

  .questionnaire-option + .questionnaire-option {
    margin-top: 8rpx;
  }

  .questionnaire-specials--multiple {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 24rpx;
  }

  .questionnaire-specials--multiple .choice-skip {
    min-height: 48rpx;
    margin-top: 4rpx;
  }
}
