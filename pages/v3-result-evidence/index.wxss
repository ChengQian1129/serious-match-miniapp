.v3-evidence-page {
  background: #fbfbfa;
}

.v3-evidence-shell {
  padding: 26rpx var(--dl-gutter) 80rpx;
}

.v3-text-action {
  min-height: 88rpx;
  margin: 0;
  padding: 26rpx 0;
  border: 0;
  background: transparent;
  color: var(--dl-black);
  font-size: 25rpx;
  line-height: 36rpx;
  text-align: left;
}

.v3-evidence-page .v3-text-action {
  box-sizing: border-box;
  width: auto;
  min-width: 88rpx;
  max-width: 100%;
  margin-right: 0;
  margin-left: 0;
}

.v3-evidence-kicker {
  margin-top: 34rpx;
  color: var(--dl-grey-500);
  font-size: 24rpx;
  font-weight: 600;
  line-height: 36rpx;
}

.v3-evidence-title {
  margin-top: 12rpx;
  font-size: 38rpx;
  font-weight: 700;
  line-height: 52rpx;
  overflow-wrap: anywhere;
  white-space: normal;
}

.v3-evidence-headline {
  margin-top: 30rpx;
  font-size: 31rpx;
  font-weight: 700;
  line-height: 44rpx;
  overflow-wrap: anywhere;
  white-space: normal;
}

.v3-evidence-summary {
  margin-top: 10rpx;
  color: #4a4a4a;
  font-size: 27rpx;
  line-height: 44rpx;
  overflow-wrap: anywhere;
  white-space: normal;
}

.v3-evidence-note {
  margin-top: 26rpx;
  padding: 20rpx 0;
  border-top: 2rpx solid var(--dl-grey-200);
  border-bottom: 2rpx solid var(--dl-grey-200);
  color: var(--dl-grey-500);
  font-size: 24rpx;
  line-height: 38rpx;
}

.v3-evidence-list {
  margin-top: 28rpx;
  border-top: 2rpx solid var(--dl-black);
}

.v3-evidence-item {
  padding: 28rpx 0 30rpx;
  border-bottom: 2rpx solid var(--dl-grey-200);
}

.v3-evidence-item__question {
  font-size: 28rpx;
  line-height: 44rpx;
}

.v3-evidence-item__label {
  color: var(--dl-grey-500);
  font-size: 22rpx;
  font-weight: 600;
  line-height: 34rpx;
}

.v3-evidence-item__answer {
  margin-top: 14rpx;
  font-size: 27rpx;
  font-weight: 600;
  line-height: 42rpx;
}

.v3-evidence-item__edit {
  min-height: 72rpx;
  margin: 8rpx 0 0;
  padding: 14rpx 0;
  border: 0;
  background: transparent;
  color: var(--dl-grey-500);
  font-size: 23rpx;
  line-height: 36rpx;
  text-align: left;
  text-decoration: underline;
}

.v3-evidence-empty {
  margin-top: 30rpx;
  color: var(--dl-grey-500);
  font-size: 27rpx;
  line-height: 44rpx;
}

.v3-evidence-page--empty .v3-evidence-shell {
  min-height: 100vh;
}

.v3-evidence-page .v3-evidence-item__edit {
  box-sizing: border-box;
  width: auto;
  min-width: 88rpx;
  max-width: 100%;
  margin-right: 0;
  margin-left: 0;
}

.v3-evidence-empty-state {
  margin-top: 112rpx;
  padding: 32rpx 0;
  border-top: 2rpx solid var(--dl-black);
  border-bottom: 2rpx solid var(--dl-black);
}

.v3-evidence-empty-state__title {
  font-size: 31rpx;
  font-weight: 700;
  line-height: 44rpx;
}

.v3-evidence-empty-state__body {
  margin-top: 14rpx;
  color: var(--dl-grey-500);
  font-size: 25rpx;
  line-height: 42rpx;
}

@media (max-width: 360px) {
  .v3-evidence-title { font-size: 33rpx; line-height: 46rpx; }
}
