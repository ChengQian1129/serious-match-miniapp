<view wx:if="{{report}}" class="page relationship-map map-enter">
  <view class="map-header"><view class="page-kicker">{{copy.kicker}}</view><view class="map-title">{{copy.title}}</view><view class="map-intro">{{copy.description}}</view></view>
  <view class="map-section map-section--claims">
    <view class="map-section__heading"><view class="map-section__index">01</view><view><view class="map-section__title">{{copy.claimsTitle}}</view><view class="map-section__desc">{{copy.claimsDescription}}</view></view></view>
    <view wx:for="{{groups}}" wx:for-item="group" wx:key="id" class="map-group">
      <view class="map-group__title">{{group.title}}</view>
      <view class="map-list map-claim-list">
        <view wx:for="{{group.claims}}" wx:for-item="claim" wx:key="id" class="map-claim" hover-class="map-claim--active" aria-role="button" data-id="{{claim.id}}" bind:tap="openClaim">
          <view class="map-claim__topline"><text class="map-claim__label">{{claim.mapLabel}}</text><text class="map-claim__status">{{claim.mapStatus}}</text></view>
          <view class="map-claim__title">{{claim.title}}</view><view class="map-claim__footer"><text>{{copy.claimBasis}}</text><text class="dl-chevron">›</text></view>
        </view>
      </view>
    </view>
  </view>
  <view wx:if="{{unknowns.length}}" class="map-section map-section--open"><view class="map-section__heading"><view class="map-section__index">02</view><view><view class="map-section__title">{{copy.unknownTitle}}</view><view class="map-section__desc">{{copy.unknownDescription}}</view></view></view><view wx:for="{{unknowns}}" wx:key="id" class="map-open-question"><view class="map-open-question__title">{{item.title}}</view><view class="map-open-question__text">{{item.text}}</view></view></view>
  <view wx:if="{{history.length > 1}}" class="map-section map-section--history"><view class="map-section__heading"><view class="map-section__index">03</view><view><view class="map-section__title">{{copy.historyTitle}}</view><view class="map-section__desc">{{copy.historyDescription}}</view></view></view><view class="map-list"><button wx:for="{{history}}" wx:key="id" class="map-history" data-id="{{item.id}}" bind:tap="openHistory"><view><view class="map-history__title">版本 {{item.version}} · {{item.title}}</view><view class="map-history__date">{{item.date}}{{item.current ? ' · 当前版本' : ''}}</view></view><text class="dl-chevron">›</text></button></view><button wx:if="{{isViewingHistory}}" class="dl-button dl-button--outline map-history-return" bind:tap="returnCurrent">返回当前版本</button></view>
  <view wx:if="{{showFollowup}}" class="map-next"><view class="map-next__kicker">{{copy.followupKicker}}</view><view class="map-next__title">{{copy.followupTitle}}</view><view class="map-next__desc">{{copy.followupDescription}}</view><button class="map-next__button" bind:tap="openFollowup">{{copy.followupAction}}</button></view>
  <view class="map-section map-section--other"><button class="dl-list-row dl-list-row--button" bind:tap="openReport"><view class="dl-list-row__body"><view class="dl-list-row__title">{{copy.reportAction}}</view><view class="dl-list-row__desc">{{copy.reportDescription}}</view></view><text class="dl-chevron">›</text></button></view>
</view>
