<view wx:if="{{report}}" class="page relationship-map map-enter">
  <view class="map-header"><view class="page-kicker">关系说明书 · 持续更新</view><view class="map-title">我的关系底图</view><view class="map-summary">{{report.title}}</view><view class="map-intro">来自当前自述的关系快照。每条判断都可以查看依据、核对或修正。</view></view>
  <view class="map-section map-section--claims">
    <view class="map-section__heading"><view class="map-section__index">01</view><view><view class="map-section__title">当前关系说明书</view><view class="map-section__desc">报告版本 {{report.reportVersion}} · 每条判断都可以查看依据、核对或修正。</view></view></view>
    <view wx:for="{{groups}}" wx:for-item="group" wx:key="id" class="map-group">
      <view class="map-group__title">{{group.title}}</view>
      <view class="map-list map-claim-list">
      <view wx:for="{{group.claims}}" wx:for-item="claim" wx:key="id" class="map-claim" hover-class="map-claim--active" aria-role="button" data-id="{{claim.id}}" bind:tap="openClaim">
        <view class="map-claim__topline"><text class="map-claim__label">{{claim.section === 'resource' ? '关系资源' : claim.section === 'tension' ? '值得留意' : '当前发现'}}</text><text class="map-claim__status">{{claim.evidence.length}} 项依据</text></view>
        <view class="map-claim__title">{{claim.title}}</view><view class="map-claim__footer"><text>查看判断边界与依据</text><text class="dl-chevron">›</text></view>
      </view>
      </view>
    </view>
  </view>
  <view wx:if="{{confirmed.length}}" class="map-section"><view class="map-section__heading"><view class="map-section__index">02</view><view><view class="map-section__title">本人已经核对的</view><view class="map-section__desc">这些描述由你确认符合或部分符合。</view></view></view><view class="map-list"><view wx:for="{{confirmed}}" wx:key="id" class="map-fact"><view class="map-fact__label">本人核对</view><view class="map-fact__text">{{item.title}}</view></view></view></view>
  <view wx:if="{{unknowns.length}}" class="map-section map-section--open"><view class="map-section__heading"><view class="map-section__index">03</view><view><view class="map-section__title">目前还不了解的</view><view class="map-section__desc">信息不足时保持未知，不强行补出结论。</view></view></view><view wx:for="{{unknowns}}" wx:key="id" class="map-open-question"><view class="map-open-question__title">{{item.title}}</view><view class="map-open-question__text">{{item.text}}</view></view></view>
  <view wx:if="{{history.length > 1}}" class="map-section map-section--history"><view class="map-section__heading"><view class="map-section__index">04</view><view><view class="map-section__title">历史版本</view><view class="map-section__desc">旧版本保留当时的回答快照，不会覆盖当前报告。</view></view></view><view class="map-list"><button wx:for="{{history}}" wx:key="id" class="map-history" data-id="{{item.id}}" bind:tap="openHistory"><view><view class="map-history__title">版本 {{item.version}} · {{item.title}}</view><view class="map-history__date">{{item.date}}{{item.current ? ' · 当前版本' : ''}}</view></view><text class="dl-chevron">›</text></button></view><button wx:if="{{isViewingHistory}}" class="dl-button dl-button--outline map-history-return" bind:tap="returnCurrent">返回当前版本</button></view>
  <view wx:if="{{showFollowup}}" class="map-next"><view class="map-next__kicker">接下来由你决定</view><view class="map-next__title">参与后续访谈与模型研究</view><view class="map-next__desc">这份报告已经完整属于你。后续访谈、模型研究或线下活动均需单独了解并自愿授权。</view><button class="map-next__button" bind:tap="openFollowup">了解后续参与</button></view>
  <view class="map-section map-section--other"><button class="dl-list-row dl-list-row--button" bind:tap="openReport"><view class="dl-list-row__body"><view class="dl-list-row__title">查看完整关系说明书</view><view class="dl-list-row__desc">整体状态、关系资源、内部拉扯和当前未知</view></view><text class="dl-chevron">›</text></button></view>
</view>
